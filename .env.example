# Copy to .env and fill in. Never commit the real .env (it's gitignored).
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=nbt_<key>.<secret>

# Optional: switch plugins off on purpose, to see what a subset of them gives (names: pathways, fms, wdm, bgp,
# secrets, inventory). Plugins that are not installed are skipped without this.
# NETBOX_SKIP_PLUGINS=wdm,pathways
